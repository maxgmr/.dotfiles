{
    // ======
    // LAYOUT
    // ======
    // "height": 33,
    "spacing": 4,
    "modules-left": [
        "hyprland/workspaces",
        "tray",
        "hyprland/submap"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "battery",
        "network",
        "cpu",
        "temperature",
        "memory"
    ],
    // =======
    // MODULES
    // =======
    "hyprland/workspaces": {
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons": {
            "1": "Ⅰ",
            "2": "Ⅱ",
            "3": "Ⅲ",
            "4": "Ⅳ",
            "5": "Ⅴ",
            "6": "Ⅵ",
            "7": "Ⅶ",
            "8": "Ⅷ",
            "9": "Ⅸ",
            "10": "Ⅹ"
        }
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "interval": 1,
        // "timezone": "America/Vancouver",
        "format": "{:%R %a %F}",
        "tooltip-format": "<span font_family=\"GoMono Nerd Font Mono\"><big>{:%T}</big>\n<small>{calendar}</small></span>",
        "calendar": {
            "format": {
                "months": "<span color='#458588'><b>{}</b></span>",
                "today": "<span color='#98971a'><b>{}</b></span>"
            }
        }
    },
    "pulseaudio": {
        "scroll-step": 1,
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-source": " {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "tooltip-format": "{desc}"
    },
    "backlight": {
        "interval": 10,
        "tooltip": false,
        "format": "{icon} {percent}%",
        // Each state is activated when above the value (all modules
        // except battery and pulseaudio)
        "states": {
            "on": 1,
            "off": 0 
        },
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "battery": {
        "interval": 60,
        "tooltip": true,
        // Each state is activated when below the value (battery and
        // pulseaudio modules only)
        "states": {
            "great": 100,
            "good": 80,
            "okay": 60,
            "bad": 40,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰢝 {capacity}%",
        "format-plugged": " {capacity}%",
        "tooltip-format": "<span font_family=\"GoMono Nerd Font Mono\"><span color='#98971a'><big>{capacity}%</big></span>\n<span color='#a89984'>Power Draw:</span> {power} W\n<span color='#a89984'>Estimate:</span> {timeTo}\n<span color='#a89984'>Total Cycles:</span> {cycles}\n<span color='#a89984'>Health:</span> {health}</span>",
        "format-time": "{H}:{m}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "network": {
        "interval": 60,
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "󰈁",
        "format-linked": "󱈘",
        // Test: nmcli networking off
        "format-disconnected": "",
        // Test: nmcli radio wifi off
        "format-disabled": "󰒲",
        "tooltip": true,
        "tooltip-format-wifi": "<span font_family=\"GoMono Nerd Font Mono\"><span color='#98971a'><big>{essid} </big></span>\n<span color='#a89984'>Interface:</span> {ifname}\n<span color='#a89984'>IP Address:</span> {ipaddr}/{cidr}\n<span color='#a89984'>Frequency:</span> {frequency} GHz</span>",
        "tooltip-format-ethernet": "<span font_family=\"GoMono Nerd Font Mono\"><span color='#98971a'><big>Ethernet 󰈁</big></span>\n<span color='#a89984'>Interface:</span> {ifname}\n<span color='#a89984'>IP Address:</span> {ipaddr}/{cidr}\n<span color='#a89984'>Frequency:</span> {frequency} GHz</span>",
        "tooltip-format-linked": "<span font_family=\"GoMono Nerd Font Mono\" color='#98971a'><big>Linked 󱈘</big></span>",
        "tooltip-format-disconnected": "<span font_family=\"GoMono Nerd Font Mono\" color='#cc241d'><big>Disconnected </big></span>",
        "tooltip-format-disabled": "<span font_family=\"GoMono Nerd Font Mono\" color='#cc241d'><big>Disabled 󰒲</big></span>",
        // Each state is activated when above the value (all modules
        // except battery and pulseaudio)
        "states": {
            "great": 80,
            "good": 60,
            "okay": 40,
            "bad": 20,
            "critical": 0
        },
        "format-icons": [
            "󰤯",
            "󰤟",
            "󰤢",
            "󰤥",
            "󰤨"
        ]
    },
    "cpu": {
        "interval": 10,
        "format": "󱅝 {usage}%",
        "tooltip": true,
        // Each state is activated when above the value (all modules
        // except battery and pulseaudio)
        "states": {
            "great": 0,
            "good": 20,
            "okay": 40,
            "bad": 60,
            "critical": 80
        }
    },
    "temperature": {
        "interval": 10,
        "format": "{icon} {temperatureC}°C",
        "tooltip": false,
        "warning-threshold": 80,
        "critical-threshold": 90,
        "format-icons": [
            "󰱫",
            "󰱫",
            "󰱱",
            "󰱴",
            "󰱩",
            "󱕼"
        ]
    },
    "memory": {
        "interval": 10,
        "format": " {percentage}% ({swapPercentage}%)",
        "tooltip": true,
        "tooltip-format": "Memory: {used:0.1f}/{total:0.1f}GiB\nSwap:   {swapUsed:0.1f}/{swapTotal:0.1f}GiB",
        "states": {
            // Each state is activated when above the value (all modules
            // except battery and pulseaudio)
            "great": 0,
            "good": 20,
            "okay": 40,
            "bad": 60,
            "critical": 80
        }
    }
}
