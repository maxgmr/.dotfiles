    helper = !/usr/bin/gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !/usr/bin/gh auth git-credential

[core]
    editor = nvim
    whitespace = trailing-space,space-before-tab

[diff]
    algorithm = minimal

[init]
    defaultBranch = main

[commit]
    verbose = true
    gpgsign = true

[merge]
    summary = true
    stat = true

[log]
    decorate = short

[diff "ruby"]
    funcname = "^ *\\(\\(def\\) .*\\)"
[diff "image"]
    textconv = identify

[safe]
	directory = /etc/portage
